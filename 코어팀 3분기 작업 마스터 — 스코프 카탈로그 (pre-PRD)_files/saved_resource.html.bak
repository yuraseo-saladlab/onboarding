 purpose:'고객을 조건으로 세그먼트화해 조회·관리한다.',
 us:'마케터로서 타깃 세그먼트를 만들어 캠페인에 쓰고 싶다.',
 ac:['조건 빌더(속성·행동, RFM)','멤버 수·미리보기','저장/재사용 → 캠페인/푸시 연결'],
 demo:['"휴면 고객" 세그먼트 생성 → 인원 확인']},
{id:'U3-4',t:'대통합',g:'U3 · 인사이트 표면',title:'코호트·리텐션 화면',st:'warn',nb:1,mod:['M7'],
 purpose:'가입/첫구매 코호트의 리텐션을 시각화한다.',
 us:'마케터로서 코호트별 잔존을 보고 개선점을 찾고 싶다.',
 ac:['코호트 정의(가입/첫구매월)','리텐션 표/히트맵','기간 비교'],
 demo:['월별 코호트 → 리텐션 히트맵']},
{id:'U3-5',t:'대통합',g:'U3 · 인사이트 표면',title:'고객 여정 화면',st:'warn',nb:1,mod:['M7'],
 purpose:'고객의 행동/구매 여정을 단계로 시각화한다.',
 us:'마케터로서 고객이 어디서 이탈하는지 보고 싶다.',
 ac:['여정 단계 정의(행동 이벤트 기반)','단계별 전환/이탈','세그먼트 필터'],
 demo:['여정 보기 → 단계별 전환율·이탈 지점']},
{id:'U3-6',t:'대통합',g:'U3 · 인사이트 표면',title:'퍼널·유입 리포트',st:'warn',nb:1,mod:['M7'],
 purpose:'유입→전환 퍼널과 채널/캠페인 성과를 리포트한다.',
 us:'마케터로서 어느 단계·채널이 약한지 보고 싶다.',
 ac:['퍼널 단계 전환율','채널/캠페인 분해','방문자수·전환율 부재 시 missing_context 표기(추정 금지)'],
 demo:['퍼널 리포트 → 단계별 드롭 + 채널 기여']},
{id:'U3-7',t:'대통합',g:'U3 · 인사이트 표면',title:'인박스 · 알림 센터',st:'warn',nb:1,mod:['M7'],
 purpose:'진단·위험·승인·멘션을 한 인박스로 모아 처리한다.',
 us:'운영자로서 챙길 일을 한 곳에서 보고 처리하고 싶다.',
 ac:['통합 인박스(진단/위험/승인/멘션 필터)','승인/처리 액션(승인 대기 항목 검토)','읽음/스누즈'],
 demo:['인박스 → 승인 대기 항목 검토/승인']}
];

const STLABEL={good:'구현',warn:'부분',none:'미착수'};
const listEl=document.getElementById('list');
const panel=document.getElementById('panel');
const pbody=document.getElementById('pbody');
const byTac={};
D.forEach(s=>{(byTac[s.t]=byTac[s.t]||[]).push(s);});
Object.keys(TACMETA).forEach(tac=>{
  const m=TACMETA[tac];const items=byTac[tac]||[];
  const tacEl=document.createElement('div');tacEl.className='tac '+m.cls;
  let html=`<div class="tachead"><span class="tk">${m.tk}</span><span class="tn">${m.tn}</span><span class="tc">${items.length} 스코프</span></div>`;
  const groups=[];const gmap={};
  items.forEach(s=>{if(!gmap[s.g]){gmap[s.g]={name:s.g,src:s.gsrc,items:[]};groups.push(gmap[s.g]);}gmap[s.g].items.push(s);});
  groups.forEach(g=>{
    html+=`<div class="grp"><div class="gh">${g.name}${g.src?` <span class="gsrc">· ${g.src}</span>`:''}</div><div class="sclist">`;
    g.items.forEach(s=>{html+=`<button class="scbtn" data-id="${s.id}"><span class="sd ${s.st}"></span><span class="nm">${s.title}</span>${s.nb?'<span class="nb">✚</span>':'<span></span>'}</button>`;});
    html+='</div></div>';
  });
  tacEl.innerHTML=html;listEl.appendChild(tacEl);
});
function render(s){
  const m=TACMETA[s.t];
  panel.querySelector('.pbar').className='pbar '+m.cls;
  pbody.innerHTML=`
    <p class="pcrumb"><b>${m.tn}</b> · ${s.g}</p>
    <h2 class="ptitle">${s.title}${s.nb?'<span class="chip nbg">✚ 보완</span>':''}</h2>
    <div class="pmeta"><span class="chip st-${s.st}">${STLABEL[s.st]}</span>${s.mod.map(x=>`<span class="chip mod">${x}</span>`).join('')}</div>
    <div class="psec"><h3>목적</h3><p class="ptext">${s.purpose}</p></div>
    <div class="psec"><h3>유저스토리</h3><p class="us">${s.us}</p></div>
    <div class="psec ac"><h3>인수조건 (AC)</h3><ul>${s.ac.map(a=>`<li>${a}</li>`).join('')}</ul></div>
    <div class="psec demo"><h3>데모 시나리오</h3><ul>${s.demo.map(d=>`<li>${d}</li>`).join('')}</ul></div>`;
  document.querySelectorAll('.scbtn').forEach(b=>b.classList.toggle('active',b.dataset.id===s.id));
}
listEl.addEventListener('click',e=>{const b=e.target.closest('.scbtn');if(!b)return;const s=D.find(x=>x.id===b.dataset.id);if(s)render(s);});
render(D[0]);
</script>

</body></html>